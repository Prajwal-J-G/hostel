{
  "name": "hostel-monorepo",
  "version": "1.0.0",
  "description": "TypeScript / PostgreSQL microservices hostel management system",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend/services/*",
    "frontend"
  ],
  "scripts": {
    "dev:infra": "docker-compose up -d",
    "dev:services": "concurrently \"npm run dev --workspace=backend/services/gateway\" \"npm run dev --workspace=backend/services/auth-service\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.2.2"
  }
}
